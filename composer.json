{
  "name": "b2pweb/bdf-api",
  "description": "Bdf Soap Api component",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Bdf\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bdf\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "conflict": {
    "b2p/bdf-api": "*",
    "b2p/bdf-soap": "*",
    "b2p/bdf-jsonrpc": "*"
  },
  "require": {
    "php": "~8.1",
    "ext-soap": "*",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-simplexml": "*",
    "psr/log": "~1.0|~2.0|~3.0",
    "symfony/http-foundation": "~5.4|~6.0|~7.0",
    "symfony/event-dispatcher": "~5.4|~6.0|~7.0",
    "symfony/http-kernel": "~5.4|~6.0|~7.0",
    "symfony/validator": "~5.4|~6.0|~7.0",
    "psr/simple-cache": "~1.0|~2.0|~3.0",
    "psr/container": "~1.0|~2.0",
    "econea/nusoap": "~0.9"
  },
  "require-dev": {
    "symfony/routing": "~5.4|~6.0|~7.0",
    "phpunit/phpunit": "~9.5",
    "php-di/php-di": "~7.1",
    "symfony/framework-bundle": "~5.4|~6.0|~7.0",
    "guzzlehttp/guzzle": "~5.3|~7.0"
  }
}
